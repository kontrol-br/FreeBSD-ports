#!/bin/sh

if [ "${2}" = "PRE-INSTALL" ]; then
	if /usr/local/sbin/pkg info -e Kontrol-pkg-E2guardian54; then
		echo "Kontrol-pkg-E2guardian5 conflicts with Kontrol-pkg-E2guardian54." >&2
		echo "Remove the 5.4 GUI package before installing the legacy package." >&2
		exit 1
	fi
	exit 0
fi

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% ${2}
