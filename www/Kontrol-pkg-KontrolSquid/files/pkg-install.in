#!/bin/sh

if [ "${2}" = "PRE-INSTALL" ]; then
	if /usr/local/sbin/pkg info -e pfSense-pkg-squid; then
		echo "Kontrol-pkg-KontrolSquid conflicts with pfSense-pkg-squid because both own the same GUI files." >&2
		echo "Remove pfSense-pkg-squid before installing the Kontrol package." >&2
		exit 1
	fi
	exit 0
fi

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% ${2}
