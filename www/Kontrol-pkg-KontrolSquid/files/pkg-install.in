#!/bin/sh

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

PKG_ROOTDIR="${PKG_ROOTDIR:-/}"

if [ -f "${PKG_ROOTDIR}/cf/conf/config.xml" ]; then
	# Checking existing CA root certs and making it available for downloading.
	cp "${PKG_ROOTDIR}/cf/conf/config.xml" "${PKG_ROOTDIR}/cf/conf/check.xml"
	awk -vc=0 -v rootdir="${PKG_ROOTDIR}" '/<ca>/{f=1; out=rootdir"/cf/conf/file_"(++c)".xml"} f{print > out} /<\/ca>/{close(out); f=0}' "${PKG_ROOTDIR}/cf/conf/check.xml"
	certfile="$(grep -Ril "kontrolproxy" "${PKG_ROOTDIR}/cf/conf"/file_*.xml 2>/dev/null | head -n1)"

	if [ -n "${certfile}" ]; then
		sed -n 's,.*<crt>\(.*\)</crt>.*,\1,p' "${certfile}" > "${PKG_ROOTDIR}/conf/certificate_B64.txt"
		base64 -d "${PKG_ROOTDIR}/conf/certificate_B64.txt" > "${PKG_ROOTDIR}/usr/local/www/certificate.crt"
		rm -f "${PKG_ROOTDIR}/cf/conf"/file_*.xml
		rm -f "${PKG_ROOTDIR}/cf/conf/check.xml" "${PKG_ROOTDIR}/conf/certificate_B64.txt"
		echo " ### Prepared kontrolproxy certificate to be downloaded by the client ###"
	else
		echo " ### WARNING! kontrolproxy certificate NOT Available ###"
		rm -f "${PKG_ROOTDIR}/cf/conf"/check* "${PKG_ROOTDIR}/cf/conf"/file* "${PKG_ROOTDIR}/cf/conf"/certificate*
	fi
fi


		#Deleting unused Samba files (reducing Security footprint) and setting the required permissions
								rm "${PKG_ROOTDIR}/usr/local/sbin/nmbd" 2> /dev/null # We don't need the NMBD - so Delete it.
								rm "${PKG_ROOTDIR}/usr/local/sbin/smbd" 2> /dev/null # We don't need the SMBD - so Delete it.
							echo "Winbind Permissions Settings"
							echo ""
								mkdir -p "${PKG_ROOTDIR}/var/db/samba4/winbindd_privileged"
								mkdir -p "${PKG_ROOTDIR}/var/db/system/samba4/winbindd_privileged"
								chown root:proxy "${PKG_ROOTDIR}/var/db/samba4/winbindd_privileged"
								chmod -R 0770 "${PKG_ROOTDIR}/var/db/samba4/winbindd_privileged"
								chown root:proxy "${PKG_ROOTDIR}/var/db/system/samba4/winbindd_privileged"
								chmod -R 0770 "${PKG_ROOTDIR}/var/db/system/samba4/winbindd_privileged"
								rm -rf "${PKG_ROOTDIR}/usr/local/etc/pkg/repos/kontrolsso.conf"
								if grep -Fxq "TLS_REQCERT never" "${PKG_ROOTDIR}/usr/local/etc/openldap/ldap.conf" ; then
								echo ""
									else
								echo "TLS_REQCERT never" >> "${PKG_ROOTDIR}/usr/local/etc/openldap/ldap.conf"
								fi


			#Checking the sqlite3 database file - Create if doesn't exist.
											if [ ! -f "${PKG_ROOTDIR}/root/kontrolid.db" ]
											then
												"${PKG_ROOTDIR}/usr/local/bin/sqlite3" "${PKG_ROOTDIR}/root/kontrolid.db" "CREATE TABLE kontrolid (ip varchar(30) UNIQUE, username varchar(30) UNIQUE, timestamp varchar(30) UNIQUE);"
											fi
													chmod 0660 "${PKG_ROOTDIR}/root/kontrolid.db"
													chown squid:proxy "${PKG_ROOTDIR}/usr/local/bin/kontrolhelper" "${PKG_ROOTDIR}/root/kontrolid.db"
echo "Before rc.packages cmd"												
"${PKG_ROOTDIR}/usr/local/bin/php" -f "${PKG_ROOTDIR}/etc/rc.packages" %%PORTNAME%% ${2}
echo "Post rc.packages cmd"
