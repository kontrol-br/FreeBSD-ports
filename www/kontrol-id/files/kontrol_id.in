#!/bin/sh

# PROVIDE: kontrol_id
# REQUIRE: NETWORKING SERVERS
# BEFORE: DAEMON
# KEYWORD: shutdown

#
# Add the following line to /etc/rc.conf to enable Kontrol-ID:
# kontrol_id_enable (bool):	Set to "NO" by default.
#				Set it to "YES" to enable Kontrol-ID.
# kontrol_id_flags (text):	Set extra engine flags.

. /etc/rc.subr

name=kontrol_id
rcvar=kontrol_id_enable
desc="Kontrol-ID secure web gateway"

load_rc_config $name

: ${kontrol_id_enable:=NO}
: ${kontrol_id_config="%%PREFIX%%/etc/e2guardian/e2guardian.conf"}

command=%%PREFIX%%/sbin/e2guardian
pidfile=/var/run/kontrol-id.pid
stop_postcmd="kontrol_id_stop_postcmd"
reload_cmd="kontrol_id_reload_cmd"
extra_commands="reload"

command_args="-p ${pidfile} -f ${kontrol_id_config}"

kontrol_id_reload_cmd() {
	if [ -r "${pidfile}" ]; then
		${command} -g -p "${pidfile}" -f "${kontrol_id_config}" ${kontrol_id_flags}
		echo "Reloading Kontrol-ID."
	fi
}

kontrol_id_stop_postcmd() {
	if [ -f "${pidfile}" ]; then
		rm -f "${pidfile}"
	fi
}

run_rc_command "$1"
