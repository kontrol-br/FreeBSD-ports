	<adddeleteeditpagefields>
		<columnitem>
			<fielddescr>Enabled</fielddescr>
			<fieldname>enabled</fieldname>
			<type>checkbox</type>
		</columnitem>
		<columnitem>
			<fielddescr>Rule Name</fielddescr>
			<fieldname>name</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Source Type</fielddescr>
			<fieldname>srctypedisp</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Source</fielddescr>
			<fieldname>srcvaluedisp</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Destination Type</fielddescr>
			<fieldname>dsttypedisp</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Destination</fielddescr>
			<fieldname>dstvaluedisp</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Gateway</fielddescr>
			<fieldname>gateway</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Description</fielddescr>
			<fieldname>description</fieldname>
		</columnitem>
		<movable>on</movable>
	</adddeleteeditpagefields>
	<fields>
		<field>
			<name>Outbound Gateway Policy Rule (Evaluated Top-Down / First-Match)</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>Enable Rule</fielddescr>
			<fieldname>enabled</fieldname>
			<type>checkbox</type>
			<default_value>on</default_value>
			<description><![CDATA[Check to enable this outbound gateway routing rule. Rules are evaluated from top to bottom (first match wins, just like firewall rules).]]></description>
		</field>
		<field>
			<fielddescr>Rule Name</fielddescr>
			<fieldname>name</fieldname>
			<description><![CDATA[Enter a short alphanumeric name for this rule (e.g., <strong>RotaItau</strong>, <strong>WanDiretoria</strong>).]]></description>
			<type>input</type>
			<size>30</size>
			<required/>
		</field>
		<field>
			<fielddescr>Description</fielddescr>
			<fieldname>description</fieldname>
			<description><![CDATA[Enter a description for reference.]]></description>
			<type>input</type>
			<size>60</size>
			<required/>
		</field>
		<field>
			<name>Source Criteria</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>Source Type</fielddescr>
			<fieldname>src_type</fieldname>
			<description><![CDATA[Select the source matching criteria for this rule.]]></description>
			<type>select</type>
			<default_value>any</default_value>
			<options>
				<option><name>Any Source</name><value>any</value></option>
				<option><name>Source IP / Subnet / Range / Alias</name><value>ip</value></option>
				<option><name>Authenticated User(s)</name><value>user</value></option>
			</options>
		</field>
		<field>
			<fielddescr>Source Value</fielddescr>
			<fieldname>src_value</fieldname>
			<description><![CDATA[
				Leave empty if <strong>Source Type</strong> is <em>Any Source</em>.<br/>
				• For <strong>Source IP / Subnet / Range / Alias</strong>: Enter a single IP (e.g., <code>10.0.0.3</code>), CIDR subnet (e.g., <code>10.0.0.0/24</code>), IP range (e.g., <code>10.0.0.10-10.0.0.50</code>), a Firewall Host/Network Alias, or multiple values separated by commas.<br/>
				• For <strong>Authenticated User(s)</strong>: Enter one or more usernames separated by commas (e.g., <code>joao, maria</code>). Matches plain usernames, <code>DOMAIN\user</code>, and <code>user@domain</code>.
			]]></description>
			<type>input</type>
			<size>70</size>
		</field>
		<field>
			<name>Destination Criteria</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>Destination Type</fielddescr>
			<fieldname>dst_type</fieldname>
			<description><![CDATA[Select the destination matching criteria for this rule.]]></description>
			<type>select</type>
			<default_value>any</default_value>
			<options>
				<option><name>Any Destination</name><value>any</value></option>
				<option><name>Domain / Wildcard Subdomain</name><value>domain</value></option>
				<option><name>URL / Path</name><value>url</value></option>
				<option><name>Destination IP / Subnet / Range / Alias</name><value>ip</value></option>
			</options>
		</field>
		<field>
			<fielddescr>Destination Value</fielddescr>
			<fieldname>dst_value</fieldname>
			<description><![CDATA[
				Leave empty if <strong>Destination Type</strong> is <em>Any Destination</em>.<br/>
				• For <strong>Domain / Wildcard Subdomain</strong>: Enter exact domain(s) (e.g., <code>www.itau.com.br</code>, <code>bradesco.net</code>) or wildcard domain(s) (e.g., <code>*.correios.com.br</code>, <code>*.itau.com.br</code> — matches both the root domain and all subdomains). Multiple entries can be separated by commas.<br/>
				• For <strong>URL / Path</strong>: Enter URL prefixes or paths (e.g., <code>www.itau.com.br/empresas</code>). Multiple entries can be separated by commas.<br/>
				• For <strong>Destination IP / Subnet / Range / Alias</strong>: Enter an IP (e.g., <code>200.211.0.1</code>), CIDR subnet (e.g., <code>200.211.10.0/24</code>, <code>200.176.0.0/16</code>), IP range, or Firewall Alias. Matches both direct IP connections and DNS-resolved IPs of requested domains!
			]]></description>
			<type>input</type>
			<size>70</size>
		</field>
		<field>
			<name>Outbound Gateway Selection</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>Gateway / Gateway Group</fielddescr>
			<fieldname>gateway</fieldname>
			<description><![CDATA[Select the outbound Gateway or Gateway Group to route matching proxy traffic through. Select <strong>default</strong> to use the system default routing table.]]></description>
			<type>select_source</type>
			<source><![CDATA[e2guardian_get_gateway_options()]]></source>
			<source_name>name</source_name>
			<source_value>value</source_value>
		</field>
	</fields>
	<custom_delete_php_command>
		sync_package_e2guardian();
		filter_configure();
	</custom_delete_php_command>
	<custom_php_command_before_form>
		e2guardian_prepare_gateways_view();
		e2guardian_check_config();
	</custom_php_command_before_form>
	<custom_php_validation_command>
		e2guardian_validate_input($_POST, $input_errors);
	</custom_php_validation_command>
	<custom_php_resync_config_command>
		sync_package_e2guardian();
		filter_configure();
	</custom_php_resync_config_command>
</packagegui>
