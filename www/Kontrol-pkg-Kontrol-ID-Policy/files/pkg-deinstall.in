#!/bin/sh

# pkg runs the old package's deinstall script while replacing it.  Package
# upgrades must preserve the generated policy, cron entries and running stack;
# the new package's post-install hook will converge the configuration.
if [ -n "${PKG_UPGRADE+x}" ]; then
	exit 0
fi

if [ -f /etc/rc.packages ]; then
	/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% ${2}
fi
