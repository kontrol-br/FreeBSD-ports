#!/bin/sh

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

# Workaround to prevent https://redmine.pfsense.org/issues/9873
if grep -q "pkg info" /etc/rc.php_ini_setup; then
	sed -i '' -e 's,pkg info,/usr/local/sbin/pkg-static info,g' \
	    /etc/rc.php_ini_setup
elif grep -q "if pkg-static info" /etc/rc.php_ini_setup; then
	sed -i '' -e 's,pkg-static info,/usr/local/sbin/pkg-static info,g' \
	    /etc/rc.php_ini_setup
fi

# Do not configure pkg repo on poudriere
if [ -f /etc/make.conf ] && grep -q 'POUDRIERE_PORTS_NAME=' /etc/make.conf; then
	exit 0
fi

REPO_PATH=/usr/local/etc/pkg/repos
REPO_CONF=${REPO_PATH}/%%PRODUCT_NAME%%.conf

if [ ! -f "%%DEFAULT_REPO%%" ]; then
	echo "===> ERROR: Default repo conf not found!"
	exit 1
fi

if [ ! -L "${REPO_CONF}" ] || [ ! -f "${REPO_CONF}" ]; then
	if [ -f "${REPO_CONF}" ]; then
		rm -f ${REPO_CONF}
	fi
	mkdir -p ${REPO_PATH}
	ln -sf %%DEFAULT_REPO%% ${REPO_CONF}
fi

PKG_CONF="/usr/local/etc/pkg.conf"
PKG_CONF_TMP="${PKG_CONF}.tmp.$$"
REAL_CONF=$(readlink ${REPO_CONF})

ABI=$(cat ${REAL_CONF%%.conf}.abi)
OSVERSION=$(cat ${REAL_CONF%%.conf}.osversion)

trap 'rm -f "${PKG_CONF_TMP}"' EXIT HUP INT TERM
cat > "${PKG_CONF_TMP}" << EOF
ABI=${ABI}
OSVERSION=${OSVERSION}
EOF
chmod 644 "${PKG_CONF_TMP}"
mv -f "${PKG_CONF_TMP}" "${PKG_CONF}"
trap - EXIT HUP INT TERM

# A completed major upgrade may leave the XML selection pointing at an
# upgrade template which the new release package no longer ships.  Keep the
# valid active symlink and XML state consistent.  Use the platform config API
# and a description so this also avoids write_config() warnings.
if [ -x /usr/local/bin/php ]; then
	/usr/local/bin/php -r '
		require_once("config.inc");
		$path = config_get_path("system/pkg_repo_conf_path");
		if (!empty($path) && !is_file($path)) {
			config_set_path("system/pkg_repo_conf_path", "%%DEFAULT_REPO%%");
			write_config("Normalize package repository after Kontrol-repo update.");
		}
	' >/dev/null 2>&1 || true
fi

# The cached dashboard result belongs to the previous repository package.
# Remove it so the widget cannot keep reporting an obsolete update status.
VERSION_CACHE_DIR=${VERSION_CACHE_DIR:-/var/run}
rm -f "${VERSION_CACHE_DIR}/%%PRODUCT_NAME%%_version" \
	"${VERSION_CACHE_DIR}/%%PRODUCT_NAME%%_version.rc"

# Help users to fix fstab before risk moving to FreeBSD 11
if /usr/bin/grep -q -E '/dev/ad[[:digit:]]' /etc/fstab; then
	echo "===> Fixing bad /etc/fstab"
	/usr/local/sbin/ufslabels.sh commit
fi

exit 0
