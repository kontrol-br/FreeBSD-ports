#!/bin/sh

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

# Workaround to prevent https://redmine.pfsense.org/issues/9873
if grep -q "pkg info" /etc/rc.php_ini_setup; then
	sed -i '' -e 's,pkg info,/usr/local/sbin/pkg-static info,g' \
	    /etc/rc.php_ini_setup
elif grep -q "if pkg-static info" /etc/rc.php_ini_setup; then
	sed -i '' -e 's,pkg-static info,/usr/local/sbin/pkg-static info,g' \
	    /etc/rc.php_ini_setup
fi

# Do not configure pkg repo on poudriere
if [ -f /etc/make.conf ] && grep -q 'POUDRIERE_PORTS_NAME=' /etc/make.conf; then
	exit 0
fi

REPO_PATH=/usr/local/etc/pkg/repos
REPO_CONF=${REPO_PATH}/%%PRODUCT_NAME%%.conf

# These names were shipped by older revisions of this package.  Do not use a
# wildcard here: administrators may keep private repository templates beside
# the package-managed ones.
MANAGED_REPO_DIR=/usr/local/share/%%PRODUCT_NAME%%/pkg/repos
for old in pfSense-repo-previous.conf pfSense-repo-previous.descr \
    pfSense-repo-previous.abi pfSense-repo-previous.altabi \
    pfSense-repo-previous.target; do
	rm -f "${MANAGED_REPO_DIR}/${old}"
done

if [ ! -f "%%DEFAULT_REPO%%" ]; then
	echo "===> ERROR: Default repo conf not found!"
	exit 1
fi

if [ ! -L "${REPO_CONF}" ]; then
	if [ -f "${REPO_CONF}" ]; then
		rm -f ${REPO_CONF}
	fi
	mkdir -p ${REPO_PATH}
	ln -sf %%DEFAULT_REPO%% ${REPO_CONF}
fi

PKG_CONF="/usr/local/etc/pkg.conf"
REAL_CONF=$(readlink ${REPO_CONF})

ABI_FILE=${REAL_CONF%%.conf}.abi
ALTABI_FILE=${REAL_CONF%%.conf}.altabi
OSVERSION_FILE=${REAL_CONF%%.conf}.osversion

if [ -f "${ABI_FILE}" ]; then
	ABI=$(cat "${ABI_FILE}")
else
	ABI="FreeBSD:$(uname -r | cut -d. -f1):$(uname -p)"
fi

# pkg on FreeBSD 15 and newer expects the canonical ABI together with a
# numeric OSVERSION.  The legacy lower-case ALTABI used by FreeBSD 14 makes
# pkg reject the configuration, so retain it only for older repositories.
TARGET_OSMAJOR=$(echo "${ABI}" | awk -F: 'tolower($1) == "freebsd" { print $2 }')
if [ -f "${ALTABI_FILE}" ]; then
	ALTABI=$(cat "${ALTABI_FILE}")
else
	ALTABI=""
fi

if [ -f "${OSVERSION_FILE}" ]; then
	TARGET_OSVERSION=$(cat "${OSVERSION_FILE}")
else
	TARGET_OSVERSION=${TARGET_OSMAJOR}00000
fi

echo "ABI=${ABI}" > ${PKG_CONF}
if [ "${TARGET_OSMAJOR}" -ge 15 ] 2>/dev/null; then
	echo "OSVERSION=${TARGET_OSVERSION}" >> ${PKG_CONF}
elif [ -n "${ALTABI}" ]; then
	echo "ALTABI=${ALTABI}" >> ${PKG_CONF}
fi

# Help users to fix fstab before risk moving to FreeBSD 11
if /usr/bin/grep -q -E '/dev/ad[[:digit:]]' /etc/fstab; then
	echo "===> Fixing bad /etc/fstab"
	/usr/local/sbin/ufslabels.sh commit
fi

exit 0
