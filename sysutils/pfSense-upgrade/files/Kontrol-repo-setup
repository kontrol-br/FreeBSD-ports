#!/bin/sh

# Repository switch helper for Kontrol 2.7.2.  The original 2.7.2 package did
# not install this executable even though pkg_switch_repo() called it.

set -u

usage() {
	cat >&2 << EOF
usage: ${0##*/} [-hU]
  -h  show this help
  -U  do not refresh repository definitions
EOF
}

no_update=""
while getopts "hU" option; do
	case "${option}" in
	h) usage; exit 0 ;;
	U) no_update=1 ;;
	*) usage; exit 64 ;;
	esac
done

product=${0##*/}
product=${product%-repo-setup}
repo_dir="/usr/local/share/${product}/pkg/repos"
repo_link="/usr/local/etc/pkg/repos/${product}.conf"
repo_link_tmp="${repo_link}.tmp.$$"
pkg_conf="/usr/local/etc/pkg.conf"
pkg_conf_tmp="${pkg_conf}.tmp.$$"

cleanup() {
	rm -f "${repo_link_tmp}" "${pkg_conf_tmp}"
}
trap cleanup EXIT HUP INT TERM

resolve_repo_conf() {
	local repo_conf repo_target repo_candidate

	if repo_conf=$(realpath "${repo_link}" 2>/dev/null) && \
	    [ -f "${repo_conf}" ]; then
		echo "${repo_conf}"
		return 0
	fi

	# Kontrol 2.7.2 pkg_switch_repo() treats the complete repository filename
	# as a directory and appends a second filename.  Recover only that exact
	# legacy shape and only when the outer, package-managed file exists.
	repo_target=$(readlink "${repo_link}" 2>/dev/null) || return 1
	case "${repo_target}" in
	"${repo_dir}/${product}-repo"*.conf/"${product}-repo-"*.conf)
		repo_candidate=${repo_target%%.conf/*}.conf
		;;
	*)
		return 1
		;;
	esac

	[ -f "${repo_candidate}" ] || return 1
	repo_conf=$(realpath "${repo_candidate}") || return 1
	case "${repo_conf}" in
	"${repo_dir}/${product}-repo"*.conf) ;;
	*) return 1 ;;
	esac

	ln -s "${repo_conf}" "${repo_link_tmp}" || return 1
	mv -f "${repo_link_tmp}" "${repo_link}" || return 1
	echo "recovered legacy repository link: ${repo_conf}" >&2
	echo "${repo_conf}"
}

_pkg() {
	/usr/local/sbin/pkg-static "$@" 2>/dev/null
}

pkg_uses_osversion() {
	local pkg_version
	pkg_version=$(_pkg query %v pkg) || return 1
	[ "$(_pkg version -t "${pkg_version}" 2.0.6)" != "<" ]
}

if [ -z "${no_update}" ] && [ -x "/usr/local/sbin/${product}-repoc-static" ]; then
	"/usr/local/sbin/${product}-repoc-static" || {
		echo "failed to refresh ${product} repository definitions" >&2
		exit 1
	}
fi

[ -L "${repo_link}" -o -f "${repo_link}" ] || {
	echo "repository configuration not found: ${repo_link}" >&2
	exit 1
}
repo_conf=$(resolve_repo_conf) || {
	echo "invalid repository configuration: ${repo_link}" >&2
	exit 1
}
repo_base=${repo_conf%.conf}

arch=$(uname -p)
current_major=$(uname -r)
current_major=${current_major%%.*}
current_abi="FreeBSD:${current_major}:${arch}"

if [ -f "${repo_base}.abi" ]; then
	target_abi=$(cat "${repo_base}.abi")
else
	target_abi=${current_abi}
fi
if [ -f "${repo_base}.altabi" ]; then
	target_altabi=$(cat "${repo_base}.altabi")
else
	case "${arch}" in
	aarch64) altarch="aarch64:64" ;;
	i386) altarch="x86:32" ;;
	armv6) altarch="armv6:32:el:eabi:hardfp" ;;
	armv7) altarch="armv7:32:el:eabi:softfp" ;;
	*) altarch="x86:64" ;;
	esac
	target_altabi="freebsd:${current_major}:${altarch}"
fi

target_major=$(echo "${target_abi}" | awk -F: 'tolower($1)=="freebsd" { print $2 }')
if [ -f "${repo_base}.osversion" ]; then
	target_osversion=$(cat "${repo_base}.osversion")
elif [ -n "${target_major}" ]; then
	target_osversion="${target_major}00000"
else
	target_osversion=$(sysctl -n kern.osreldate)
fi

new_major=""
if [ -n "${target_major}" ] && [ "${current_major}" != "${target_major}" ]; then
	new_major=1
	export IGNORE_OSVERSION=yes
elif [ "${current_abi}" != "${target_abi}" ]; then
	new_major=1
	export IGNORE_OSVERSION=yes
fi

if [ -n "${new_major}" ] || pkg_uses_osversion; then
	cat > "${pkg_conf_tmp}" << EOF
ABI=${target_abi}
OSVERSION=${target_osversion}
EOF
else
	cat > "${pkg_conf_tmp}" << EOF
ABI=${target_abi}
ALTABI=${target_altabi}
EOF
fi

chmod 0644 "${pkg_conf_tmp}"
mv -f "${pkg_conf_tmp}" "${pkg_conf}"

# The 2.7.2 WebGUI starts its own metadata refresh without forwarding the
# cross-major environment.  Start one compatible refresh here so the version
# cache is populated even when that legacy background refresh fails.
if [ -n "${new_major}" ] && [ -x /etc/rc.update_pkg_metadata ]; then
	/usr/bin/env IGNORE_OSVERSION=yes /etc/rc.update_pkg_metadata now ||
		echo "warning: unable to start compatible metadata refresh" >&2
fi

trap - EXIT HUP INT TERM
exit 0
